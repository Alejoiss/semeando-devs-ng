{
  "name": "semeandodevsapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/fetch-public-catalog.mjs",
    "start": "ng serve --port 4201",
    "prebuild": "node scripts/fetch-public-catalog.mjs",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --reporters=dots",
    "lint": "ng lint",
    "test:edge": "deno test --allow-env --allow-net=esm.sh,jsr.io,deno.land supabase/functions",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:backend:start": "node e2e/backend/stack.mjs start",
    "e2e:backend:stop": "node e2e/backend/stack.mjs stop",
    "e2e:backend:reset": "node e2e/backend/stack.mjs reset",
    "test:coverage": "npm run test:coverage:karma && npm run test:coverage:edge",
    "test:coverage:karma": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage --reporters=dots",
    "test:coverage:edge": "deno test --allow-env --allow-net=esm.sh,jsr.io,deno.land --coverage=coverage/edge supabase/functions && deno coverage coverage/edge --include=supabase/functions --exclude=_testing,\\.test\\.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.18",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "20.3.18",
    "@angular/compiler": "20.3.18",
    "@angular/core": "20.3.18",
    "@angular/forms": "20.3.18",
    "@angular/platform-browser": "20.3.18",
    "@angular/platform-server": "20.3.18",
    "@angular/router": "20.3.18",
    "@angular/service-worker": "20.3.18",
    "@angular/ssr": "^20.3.18",
    "@mercadopago/sdk-js": "^0.0.3",
    "@ngstack/code-editor": "^9.0.0",
    "@supabase/supabase-js": "^2.103.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.1",
    "marked": "^16.4.2",
    "material-symbols": "^0.42.3",
    "ngx-echarts": "^20.0.2",
    "ngx-markdown": "^20.1.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.18",
    "@angular/cli": "20.3.18",
    "@angular/compiler-cli": "20.3.18",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.27",
    "deno": "^2.9.6",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.8",
    "supabase": "^2.88.0",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}
